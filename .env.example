# Upstox API credentials. Copy this file to .env (no extension) and
# fill in your real values.
#
# Get these from: https://account.upstox.com/developer/apps
#   1. Log in to Upstox
#   2. Click "Developer" -> "Apps" -> "Create App"
#   3. App type: "Trading API" / Web App
#   4. Redirect URI: anything you control, e.g. http://localhost:8000/auth/callback
#      (The dashboard will ask you to paste this redirect URL after login.)
#   5. Copy the API Key, API Secret, and the Redirect URI you set.

UPSTOX_API_KEY=paste-your-api-key-here
UPSTOX_API_SECRET=paste-your-api-secret-here
UPSTOX_REDIRECT_URI=http://localhost:8000/auth/callback

# ---------------------------------------------------------------------------
# Telegram alerts (optional but strongly recommended).
# Without these, telegram_notifier silently disables itself: the bot will
# trade fine but you'll see no entry/exit alerts and no EOD summary.
#
# How to get the values (5 minutes):
#   1. On Telegram, search for "@BotFather", send /newbot, follow prompts.
#      Copy the HTTP API token it gives you -> TELEGRAM_BOT_TOKEN.
#   2. Search for "@userinfobot" on Telegram and start it. It replies
#      with your numeric user ID -> TELEGRAM_CHAT_ID.
#   3. Send any message to YOUR new bot first (it cannot DM you until
#      you've initiated the conversation).
#   4. Test with:  python test_telegram.py
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
