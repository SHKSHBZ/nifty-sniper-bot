{
  "version": "1.1",
  "purpose": "Single source of truth for all historical data the bot needs. User updates 'status' as they download. AI assumes data exists in 'data/' once status='downloaded'.",
  "data_directory": "data/",
  "scripts_directory": "backtesting/",
  "last_updated": "2026-05-10",
  "backtest_window_decision": {
    "effective_window": "2024-11 to 2025-08 (~12 months)",
    "reason": "Upstox /v2/expired-instruments/future/* has a rolling ~12-month retention; contracts expiring Sep 2025 or later return empty payloads and cannot be fetched. Spot/VIX/options cover the full 18 months but futures volume only covers Nov 2024 -> Aug 2025. To keep Volume Profile inputs consistent, all backtests run on the Nov 2024 -> Aug 2025 window.",
    "decided_on": "2026-05-10"
  },

  "instructions_for_user": [
    "1. Look at any dataset with status='pending' and run its 'download_command'",
    "2. After successful download, change status to 'downloaded' and commit this file",
    "3. Use 'expected_files' or 'expected_rows' as the sanity check after download",
    "4. Datasets are ranked by priority; do critical first, then high, then medium",
    "5. Tell the AI which datasets you completed so it knows what to use"
  ],

