# Environments
.env
.venv
env/
venv/
venv_nifty/

# Python
__pycache__/
*.py[cod]
*$py.class
*.pkl

# Configuration and Secrets
config.yaml
config/
state/

# Data and Logs
# Ignore everything in data/ except a small set of curated CSVs.
# Per-strike historical option data (*_1min.csv) and index/VIX spot
# series (*_1minute.csv) are regenerable from the Upstox API, so we
# don't track them — too large for git, and cause noisy diffs.
data/*
!data/*.csv
!data/.gitkeep
data/*_1min.csv
data/*_1minute.csv
historical/
*.log
*.txt
!requirements.txt

# AI Conversations
gemini-conversation*.json
sim_output.txt
sim.txt
yt.txt
yt_hi.txt
yt_utf8.txt

# Images
*.jpg
*.png
