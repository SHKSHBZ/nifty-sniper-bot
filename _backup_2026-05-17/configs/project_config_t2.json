{
    "project_name": "NiftySensex_Weekly_Options_Buyer_Bot",
    "version": "2.0.0-t2",
    "trading_index": "NIFTY",
    "_t2_summary": "T2-only mode. Engine runs in 'regime' but T2 fires before regime routing on expiry days at 14:50-15:00 when both ATM CE and PE premiums are in [Rs.5, Rs.20] band. Two-leg straddle (BUY ATM CE + ATM PE), exits on combined -50% SL or 15:25 force-close.",
    "environment": {
        "local_inference_url": "http://localhost:11434",
        "local_model": "qwen3:32b-coder",
        "external_ai_provider": "gemini",
        "external_ai_model": "gemini-2.0-flash",
        "broker_api": "Upstox-v2"
    },
    "risk": {
        "max_daily_loss_inr": 12000,
        "per_trade_sl_pct": 50,
        "per_trade_target_pct": 0,
        "risk_per_trade_pct": 1.0,
        "order_type": "LIMIT",
        "limit_buffer_pct": 0.5
    },
    "strategy": {
        "name": "t2_expiry_straddle_S2",
        "timeframes": ["5min", "15min"],
        "min_signal_score": 3,
        "candle_timeframe_minutes": 5,
        "nifty_strike_step": 50,
        "sensex_strike_step": 100,
        "nifty_lot_size": 65,
        "sensex_lot_size": 20,
        "min_premium": 5.0,
        "atr_threshold": 6.0,
        "time_gate": "14:50:00",
        "time_exit": "15:25:00",
        "eod_exit": "15:25:00"
    },
    "dte_risk": {
        "extreme_threshold": 3,
        "high_threshold": 7,
        "expiry_day_size_reduction": 1.0
    },
    "hedging": {
        "enabled": false,
        "mode": "debit_spread_on_extreme_dte",
        "spread_strike_gap": 50
    },
    "iv_filter": {
        "enabled": false,
        "max_iv_percentile": 50
    },
    "oi_analysis": {
        "focus_zone_strikes": 3,
        "pcr_bullish_threshold": 1.0,
        "pcr_bearish_threshold": 0.8,
        "pcr_contrarian_upper": 1.5,
        "pcr_contrarian_lower": 0.7
    },
    "slippage": {
        "entry_pct": 1.5,
        "exit_pct": 1.5,
        "brokerage_per_leg": 30
    },
    "alerts": {
        "telegram_enabled": true,
        "log_full_reasoning": true
    },
    "engine_mode": "regime",
    "_engine_mode_help": "regime mode is REQUIRED for T2 (T2 lives inside the dispatcher).",
    "journal_enabled": true,
    "modes": {
        "paper_trade": true,
        "backtest": false,
        "live": false
    },
    "modules": [
        "data_fetcher.py",
        "telegram_notifier.py",
        "tactics/t2_expiry_straddle.py"
    ]
}
