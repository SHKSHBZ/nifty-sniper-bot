{
    "project_name": "NiftySensex_Weekly_Options_Buyer_Bot",
    "version": "2.0.0-t1",
    "trading_index": "NIFTY",
    "focus_zone_writer": false,
    "_t1_summary": "T1-only mode. Engine runs in 'regime' but T1 fires before regime routing each tick — at most once per day in [10:00, 10:30] when VIX gates pass. Other regime tactics still run when T1 stays silent (most of the day).",
    "environment": {
        "local_inference_url": "http://localhost:11434",
        "local_model": "qwen3:32b-coder",
        "external_ai_provider": "gemini",
        "external_ai_model": "gemini-2.0-flash",
        "broker_api": "Upstox-v2"
    },
    "risk": {
        "max_daily_loss_inr": 5000,
        "per_trade_sl_pct": 30,
        "per_trade_target_pct": 30,
        "risk_per_trade_pct": 1.0,
        "order_type": "LIMIT",
        "limit_buffer_pct": 0.5
    },
    "strategy": {
        "name": "t1_vix_direction_tuned",
        "timeframes": ["5min", "15min"],
        "min_signal_score": 3,
        "candle_timeframe_minutes": 5,
        "nifty_strike_step": 50,
        "sensex_strike_step": 100,
        "nifty_lot_size": 65,
        "sensex_lot_size": 20,
        "min_premium": 20.0,
        "atr_threshold": 6.0,
        "time_gate": "10:00:00",
        "time_exit": "14:30:00",
        "eod_exit": "15:25:00"
    },
    "dte_risk": {
        "extreme_threshold": 3,
        "high_threshold": 7,
        "expiry_day_size_reduction": 0.50
    },
    "hedging": {
        "enabled": false,
        "mode": "debit_spread_on_extreme_dte",
        "spread_strike_gap": 50
    },
    "iv_filter": {
        "enabled": true,
        "max_iv_percentile": 50
    },
    "oi_analysis": {
        "focus_zone_strikes": 3,
        "pcr_bullish_threshold": 1.0,
        "pcr_bearish_threshold": 0.8,
        "pcr_contrarian_upper": 1.5,
        "pcr_contrarian_lower": 0.7
    },
    "slippage": {
        "entry_pct": 1.5,
        "exit_pct": 1.5,
        "brokerage_per_leg": 30
    },
    "alerts": {
        "telegram_enabled": true,
        "log_full_reasoning": true
    },
    "engine_mode": "regime",
    "_engine_mode_help": "regime mode is REQUIRED for T1 (T1 lives inside the dispatcher).",
    "journal_enabled": true,
    "modes": {
        "paper_trade": true,
        "backtest": false,
        "live": false
    },
    "modules": [
        "signal_engine.py",
        "data_fetcher.py",
        "telegram_notifier.py",
        "tactics/t1_vix_direction.py"
    ]
}
